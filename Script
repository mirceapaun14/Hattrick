# =================================================================
# HATTRICK YOUTH ACADEMY OPTIMIZER (HARDWARE POSITION BARRIERS)
# =================================================================
$skillFile = Join-Path $PSScriptRoot "skill.txt"
$starFile  = Join-Path $PSScriptRoot "stars.txt"

if (-not (Test-Path $skillFile) -or -not (Test-Path $starFile)) {
    Write-Host "Error: Make sure 'skill.txt' and 'stars.txt' exist in folder: $PSScriptRoot" -ForegroundColor Red
    exit
}

# 1. Read skill.txt
$playersData = [System.Collections.ArrayList]::new()
Get-Content -Path $skillFile -Encoding UTF8 | Where-Object { $_.Trim() -ne '' } | ForEach-Object {
    $c = $_.Split("`t ") | Where-Object { $_ -ne '' }
    if ($c.Count -ge 6) {
        $playersData.Add(@{ 
            Name    = ($c | Select-Object -Index 0)
            DEF     = ($c | Select-Object -Index 1)
            PM      = ($c | Select-Object -Index 2)
            Wing    = ($c | Select-Object -Index 3)
            Pass    = ($c | Select-Object -Index 4)
            Scoring = ($c | Select-Object -Index 5)
        }) | Out-Null
    }
}

# 2. Read stars.txt
$matchStars = [System.Collections.ArrayList]::new()
Get-Content -Path $starFile -Encoding UTF8 | Where-Object { $_.Trim() -ne '' } | ForEach-Object {
    $c = $_.Split("`t ") | Where-Object { $_ -ne '' }
    if ($c.Count -ge 6) {
        $matchStars.Add(@{ 
            Name    = ($c | Select-Object -Index 0)
            CD      = [double]($c | Select-Object -Index 1)
            WB      = [double]($c | Select-Object -Index 2)
            IM      = [double]($c | Select-Object -Index 3)
            Winger  = [double]($c | Select-Object -Index 4)
            Forward = [double]($c | Select-Object -Index 5)
        }) | Out-Null
    }
}

# 3. Range converter function
function Get-HattrickRange ($rawVal) {
    if ([string]::IsNullOrWhiteSpace($rawVal) -or $rawVal -eq '?') { return @{ min = 1.0; max = 7.75 } }
    $text = $rawVal.ToString().Trim().Replace(',', '.')
    if ($text -like "*/*") {
        $parts = $text.Split('/')
        $v1 = [double]($parts | Select-Object -First 1)
        $v2 = [double]($parts | Select-Object -Last 1)
        if ($v1 -eq 1.0 -and $v2 -gt 1.0) { return @{ min = 1.0; max = $v2 + 0.75 } }
        return @{ min = $v1; max = $v1 + 0.75 }
    }
    $fix = [double]$text
    return @{ min = $fix; max = $fix + 0.75 }
}

# Strict error calculation function
function Get-StrictError ($d, $pm, $w, $ps, $s, $m) {
    $simCD  = $d * 0.74 + $pm * 0.18 + $ps * 0.08
    $simWB  = $d * 0.56 + $w * 0.24 + $pm * 0.15 + $ps * 0.05
    $simIM  = $pm * 0.73 + $d * 0.14 + $ps * 0.13
    $simWng = $w * 0.56 + $pm * 0.24 + $ps * 0.15 + $d * 0.05
    $simFwd = $s * 0.73 + $ps * 0.22 + $w * 0.05
    
    $sum = 0.0
    $count = 0
    if ($m.CD -gt 0)      { $sum += [Math]::Abs($simCD - $m.CD); $count++ }
    if ($m.WB -gt 0)      { $sum += [Math]::Abs($simWB - $m.WB); $count++ }
    if ($m.IM -gt 0)      { $sum += [Math]::Abs($simIM - $m.IM); $count++ }
    if ($m.Winger -gt 0)  { $sum += [Math]::Abs($simWng - $m.Winger); $count++ }
    if ($m.Forward -gt 0) { $sum += [Math]::Abs($simFwd - $m.Forward); $count++ }
    
    if ($count -eq 0) { return 0.0 }
    return $sum / $count
}

# 4. Processing and Optimization
$results = @()
foreach ($p in $playersData) {
    $name = $p.Name
    $m = $matchStars | Where-Object { $_.Name -eq $name }
    if (-not $m) { continue }
    
    $rDef = Get-HattrickRange $p.DEF
    $rPm  = Get-HattrickRange $p.PM
    $rWng = Get-HattrickRange $p.Wing
    $rPas = Get-HattrickRange $p.Pass
    $rSco = Get-HattrickRange $p.Scoring
    
    # Initial Grid Search
    $bestErr = 999.0
    $cDef = $rDef.min; $cPm = $rPm.min; $cWng = $rWng.min; $cPas = $rPas.min; $cSco = $rSco.min
    $testFactors = @(0.2, 0.5, 0.8)

    foreach ($fDef in $testFactors) {
        foreach ($fPm in $testFactors) {
            foreach ($fWng in $testFactors) {
                foreach ($fPas in $testFactors) {
                    foreach ($fSco in $testFactors) {
                        $tDef = $rDef.min + ($rDef.max - $rDef.min) * $fDef
                        $tPm  = $rPm.min  + ($rPm.max - $rPm.min)  * $fPm
                        $tWng = $rWng.min + ($rWng.max - $rWng.min) * $fWng
                        $tPas = $rPas.min + ($rPas.max - $rPas.min) * $fPas
                        $tSco = $rSco.min + ($rSco.max - $rSco.min) * $fSco

                        $e = Get-StrictError $tDef $tPm $tWng $tPas $tSco $m
                        if ($e -lt $bestErr) {
                            $bestErr = $e
                            $cDef = $tDef; $cPm = $tPm; $cWng = $tWng; $cPas = $tPas; $cSco = $tSco
                        }
                    }
                }
            }
        }
    }
    
    # Fine Micro-optimization
    $currErr = $bestErr
    $microSteps = @(0.10, -0.10, 0.02, -0.02)
    for ($step = 0; $step -lt 60; $step++) {
        $moved = $false
        foreach ($delta in $microSteps) {
            foreach ($var in @('DEF','PM','Wing','Pass','Scoring')) {
                $tDef = $cDef; $tPm = $cPm; $tWng = $cWng; $tPas = $cPas; $tSco = $cSco
                switch ($var) {
                    'DEF'     { $tDef = [Math]::Max($rDef.min, [Math]::Min($rDef.max, $cDef + $delta)) }
                    'PM'      { $tPm  = [Math]::Max($rPm.min,  [Math]::Min($rPm.max,  $cPm + $delta)) }
                    'Wing'    { $tWng = [Math]::Max($rWng.min, [Math]::Min($rWng.max, $cWng + $delta)) }
                    'Pass'    { $tPas = [Math]::Max($rPas.min, [Math]::Min($rPas.max, $cPas + $delta)) }
                    'Scoring' { $tSco = [Math]::Max($rSco.min, [Math]::Min($rSco.max, $cSco + $delta)) }
                }
                $e = Get-StrictError $tDef $tPm $tWng $tPas $tSco $m
                if ($e -lt $currErr -or ($e -eq $currErr -and $tPas -gt $cPas -and $var -eq 'Pass')) {
                    $currErr = $e; $cDef = $tDef; $cPm = $tPm; $cWng = $tWng; $cPas = $tPas; $cSco = $tSco
                    $moved = $true
                }
            }
        }
        if (-not $moved) { break }
    }
    
    # ABSOLUTE MATHEMATICAL BARRIERS (Without checking text from skill.txt)
    $finalDef = "{0:N2}" -f $cDef -replace '\.', ','
    $finalPm  = "{0:N2}" -f $cPm  -replace '\.', ','
    $finalWng = "{0:N2}" -f $cWng -replace '\.', ','
    $finalPas = "{0:N2}" -f $cPas -replace '\.', ','
    $finalSco = "{0:N2}" -f $cSco -replace '\.', ','

    # 1. If player did not play in a defensive position -> DEF becomes "?"
    if ($m.CD -eq 0 -and $m.WB -eq 0 -and $m.IM -eq 0) { $finalDef = "?" }
    
    # 2. If player did not play in a position that uses Playmaking -> PM becomes "?"
    if ($m.IM -eq 0 -and $m.Winger -eq 0 -and $m.WB -eq 0) { $finalPm  = "?" }
    
    # 3. If player has no match as a forward -> Scoring becomes "?" mandatory
    if ($m.Forward -eq 0) { $finalSco = "?" }
    
    # 4. Wing becomes "?" if player did not play on the flanks (Winger or WB)
    if ($m.Winger -eq 0 -and $m.WB -eq 0) { $finalWng = "?" }
    
    # 5. Passing (If player did not play anywhere at all)
    if ($m.CD -eq 0 -and $m.WB -eq 0 -and $m.IM -eq 0 -and $m.Winger -eq 0 -and $m.Forward -eq 0) { $finalPas = "?" }

    $results += [PSCustomObject]@{
        Player  = $name
        DEF     = $finalDef
        PM      = $finalPm
        Wing    = $finalWng
        Pass    = $finalPas
        Scoring = $finalSco
    }
}

Write-Host "`n=== OPTIMIZED FINAL RESULTS (HARDWARE BARRIERS ENGINE) ===" -ForegroundColor Cyan
$results | Format-Table -AutoSize
